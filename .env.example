# Copiá este archivo como .env.local y completá los valores del proyecto.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Compatibilidad temporal con proyectos que todavía muestran la clave anon heredada.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo servidor y Edge Functions. Nunca uses el prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Lectura de fotos con Gemini (Google AI Studio).
# Se trata igual que la clave privilegiada de Supabase: solo servidor, nunca con
# el prefijo NEXT_PUBLIC_, y en producción va como secreto del Worker.
# Sin esta variable, las herramientas de foto quedan apagadas y el resto del
# sistema funciona igual.
GEMINI_API_KEY=

NEXT_PUBLIC_SITE_URL=http://localhost:3000

