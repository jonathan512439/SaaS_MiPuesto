{
  "name": "mipuesto",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "npm run security:client-secrets",
    "build": "next build",
    "start": "next start",
    "prelint": "npm run security:client-secrets",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "npm run test:contraste && npm run test:tokens && vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:contraste": "node scripts/check-design-contrast.mjs",
    "patrones": "node scripts/armar-patrones.mjs",
    "test:tokens": "node scripts/check-design-tokens.mjs",
    "test:rls": "supabase test db --local supabase/tests/database",
    "test:rls:estructura:linked": "supabase db query --linked --file supabase/tests/remote/fase2-audit.sql",
    "test:rls:multitenant": "node --env-file-if-exists=.env.local scripts/test-rls-multitenant.mjs",
    "test:rls:linked": "npm run test:rls:estructura:linked && npm run test:rls:multitenant",
    "test:reservas:linked": "supabase db query --linked --file supabase/tests/remote/fase6-reservas.sql",
    "test:fase7:linked": "supabase db query --linked --file supabase/tests/remote/fase7-audit.sql",
    "test:fase8:linked": "supabase db query --linked --file supabase/tests/remote/fase8-audit.sql",
    "test:fase9:linked": "supabase db query --linked --file supabase/tests/remote/fase9-audit.sql",
    "supabase:functions:deploy": "supabase functions deploy ping-keepalive --use-api",
    "ops:keepalive:configurar": "node --env-file-if-exists=.env.local scripts/configurar-keepalive.mjs",
    "auth:invitar": "node --env-file-if-exists=.env.local scripts/invitar-admin.mjs",
    "suscripcion:ver": "node --env-file-if-exists=.env.local scripts/suscripciones.mjs ver",
    "suscripcion:renovar": "node --env-file-if-exists=.env.local scripts/suscripciones.mjs renovar",
    "cloudflare:secret:pedidos": "node --env-file-if-exists=.env.local scripts/configurar-secreto-pedidos-cloudflare.mjs",
    "cloudflare:secret:gemini": "node --env-file-if-exists=.env.local scripts/configurar-secreto-gemini.mjs",
    "auth:enlace": "node --env-file-if-exists=.env.local scripts/enlace-clave.mjs",
    "db:lint": "supabase db lint --local --schema public --fail-on error",
    "db:lint:linked": "supabase db lint --linked --schema public --fail-on error",
    "types:db:linked": "supabase gen types --linked --lang typescript --schema public > lib/supabase/database.types.ts",
    "security:client-secrets": "node scripts/check-client-secrets.mjs",
    "security:repository-secrets": "node scripts/check-repository-secrets.mjs",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:reset": "supabase db reset",
    "supabase:push:dry": "supabase db push --linked --dry-run",
    "supabase:push": "supabase db push --linked",
    "supabase:seed:local": "supabase db push --local --include-seed",
    "dev:vinext": "vinext dev --port 3001",
    "build:vinext": "vinext build",
    "postbuild:vinext": "npm run security:client-secrets",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json",
    "deploy:vinext": "wrangler deploy --config dist/server/wrangler.json --keep-vars",
    "salud": "node --env-file-if-exists=.env.local scripts/salud.mjs",
    "plataforma:admin": "node --env-file-if-exists=.env.local scripts/plataforma-admin.mjs",
    "respaldo:verificar": "node --env-file-if-exists=.env.local scripts/verificar-respaldo.mjs",
    "planilla:diagnosticar": "node --experimental-strip-types --no-warnings scripts/diagnosticar-planilla.mjs",
    "iconos": "node scripts/armar-iconos.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.5",
    "@supabase/supabase-js": "2.112.4",
    "@vinext/cloudflare": "1.0.0-beta.6",
    "next": "16.3.4",
    "qrcode": "1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-server-dom-webpack": "19.2.8",
    "vinext": "1.0.0-beta.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.2",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.4.0",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "@vitejs/plugin-rsc": "0.5.34",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "lucide-static": "1.42.0",
    "supabase": "2.116.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "wrangler": "4.127.1"
  },
  "type": "module"
}
