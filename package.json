{
  "name": "mipuesto",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "npm run security:client-secrets",
    "build": "next build",
    "start": "next start",
    "prelint": "npm run security:client-secrets",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:rls": "supabase test db --local supabase/tests/database",
    "test:rls:linked": "supabase test db --linked supabase/tests/database",
    "db:lint": "supabase db lint --local --schema public --fail-on error",
    "db:lint:linked": "supabase db lint --linked --schema public --fail-on error",
    "security:client-secrets": "node scripts/check-client-secrets.mjs",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:reset": "supabase db reset",
    "supabase:push:dry": "supabase db push --linked --dry-run",
    "supabase:push:dev": "supabase db push --linked --include-seed"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.5",
    "@supabase/supabase-js": "2.112.4",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "supabase": "2.116.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
