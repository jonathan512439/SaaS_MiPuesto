{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "//exclude": "Catalogos_Ejemplo es el frontend de referencia: tiene su propio proyecto, su propio React y sus propias dependencias. Está fuera de git y no se compila acá; sin esta exclusión, `tsc` lo recorre y reporta cientos de errores de un código que no es nuestro.",
  "exclude": ["node_modules", "Catalogos_Ejemplo"]
}

